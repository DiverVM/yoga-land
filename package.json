{
  "name": "yourmoov",
  "version": "1.2.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup:local": "[ -f .env.local ] || cp .env.example .env.local && mkdir -p data && npm run db:migrate:local && npm run db:seed:local",
    "setup:stage": "[ -f .env ] && npm run db:migrate:env && npm run db:seed:env || (echo '.env file not found' && exit 1)",
    "setup:prod": "[ -f .env.prod ] && npm run db:migrate:prod && npm run db:seed:prod || (echo '.env.prod file not found' && exit 1)",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed-all.ts",
    "db:seed:local": "dotenv -e .env.local -- tsx scripts/seed-all.ts",
    "db:seed:env": "dotenv -e .env -- tsx scripts/seed-all.ts",
    "db:seed:prod": "dotenv -e .env.prod -- tsx scripts/seed-all.ts",
    "db:seed:admin": "tsx scripts/seed-admin.ts",
    "db:seed:products": "tsx scripts/seed-products.ts",
    "db:seed:admin:local": "dotenv -e .env.local -- tsx scripts/seed-admin.ts",
    "db:seed:products:local": "dotenv -e .env.local -- tsx scripts/seed-products.ts",
    "db:seed:admin:env": "dotenv -e .env -- tsx scripts/seed-admin.ts",
    "db:seed:products:env": "dotenv -e .env -- tsx scripts/seed-products.ts",
    "db:seed:admin:prod": "dotenv -e .env.prod -- tsx scripts/seed-admin.ts",
    "db:seed:products:prod": "dotenv -e .env.prod -- tsx scripts/seed-products.ts",
    "db:migrate:local": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:push:local": "dotenv -e .env.local -- drizzle-kit push",
    "db:studio:local": "dotenv -e .env.local -- drizzle-kit studio",
    "db:migrate:env": "dotenv -e .env -- drizzle-kit migrate",
    "db:push:env": "dotenv -e .env -- drizzle-kit push",
    "db:studio:env": "dotenv -e .env -- drizzle-kit studio",
    "db:migrate:prod": "dotenv -e .env.prod -- drizzle-kit migrate",
    "db:push:prod": "dotenv -e .env.prod -- drizzle-kit push",
    "db:studio:prod": "dotenv -e .env.prod -- drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "i18next": "^26.0.10",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "next": "16.2.5",
    "pdfjs-dist": "^5.6.205",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^17.0.7",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
